# ==============================================================================
# MUSCLE WEAPON ENVIRONMENT CONFIGURATION
# ==============================================================================
# IMPORTANT:
# - This file contains variable names ONLY and setup documentation.
# - NEVER commit actual secret keys or credentials to version control.
# - Duplicate this file as .env.local for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Setup Instructions:
# 1. Create a project at https://supabase.com
# 2. In Project Settings > API:
#    - Copy "Project URL" into NEXT_PUBLIC_SUPABASE_URL
#    - Copy "anon public" key into NEXT_PUBLIC_SUPABASE_ANON_KEY
#    - Copy "service_role" secret key into SUPABASE_SERVICE_ROLE_KEY
# CAUTION: SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security and must
# NEVER be exposed to the client or browser bundles.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# CLOUDINARY CONFIGURATION
# ------------------------------------------------------------------------------
# Setup Instructions:
# 1. Create a Cloudinary account at https://cloudinary.com
# 2. In Cloudinary Console Dashboard:
#    - Copy "Cloud Name" into NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME
#    - Copy "API Key" into NEXT_PUBLIC_CLOUDINARY_API_KEY
#    - Copy "API Secret" into CLOUDINARY_API_SECRET
# CAUTION: CLOUDINARY_API_SECRET must NEVER be exposed in client code.
# All image upload signatures and media management must run server-side.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# ------------------------------------------------------------------------------
# APPLICATION & SECURITY CONFIGURATION
# ------------------------------------------------------------------------------
# Base URL for public site (e.g. http://localhost:3000 in dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Verification system configuration (documented defaults from PRD)
VERIFICATION_RATE_LIMIT_MAX_ATTEMPTS=5
VERIFICATION_RATE_LIMIT_WINDOW_SECONDS=60
